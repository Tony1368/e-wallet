      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /transactions/users/{id}" enabled="true">
          <stringProp name="HTTPSampler.domain">${BASE_URL}</stringProp>
